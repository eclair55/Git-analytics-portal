{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ReportConfig": {
    "OutputDirectory": "./Reports",
    "StaleBranchThresholdDays": 30,
    "ReportTitle": "Git Analytics Dashboard",
    "ComparisonLimit": 100,
    "ConsoleRowLimit": 200,
    "MaxComparisonFileKB": 256,
    "MaxDiffChars": 200000,
    "IncludePaths": [],
    "ExcludePaths": [
      "bin/",
      "obj/",
      ".vs/",
      ".idea/",
      "node_modules/",
      "packages/",
      "*.user",
      "*.suo",
      "*.min.js",
      "*.min.css",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "packages.lock.json"
    ],
    "Mailmap": [],
    "TicketPattern": "\\b[A-Z][A-Z0-9]+-\\d+\\b|(?<![\\w/&])#\\d+\\b",
    "TicketUrlTemplate": ""
  }
}
